          "expr": "quantile_over_time(0.5, {service=\"dynamic-sorting-application\"} |= `\"record\":\"package\"` | json value=\"commandDelayMs\" | unwrap value | __error__=\"\" [2m]) by (service)",
          "legendFormat": "command median",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "cB",
          "expr": "quantile_over_time(0.95, {service=\"dynamic-sorting-application\"} |= `\"record\":\"package\"` | json value=\"commandDelayMs\" | unwrap value | __error__=\"\" [2m]) by (service)",
          "legendFormat": "command 95th percentile",
          "queryType": "range"
        }
