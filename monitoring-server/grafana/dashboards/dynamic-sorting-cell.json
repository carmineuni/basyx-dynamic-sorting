          },
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service=\"dynamic-sorting-application\"} |= `\"record\":\"package\"` | json value=\"endToEndMs\" | unwrap value | __error__=\"\" [2m]) by (service)",
          "legendFormat": "median",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service=\"dynamic-sorting-application\"} |= `\"record\":\"package\"` | json value=\"endToEndMs\" | unwrap value | __error__=\"\" [2m]) by (service)",
          "legendFormat": "95th percentile",
          "queryType": "range"
        }
