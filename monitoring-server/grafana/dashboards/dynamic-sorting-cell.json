        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Change event and command delays",
      "description": "Event: from SensedProperties written to the change event received. Command: from the decision to the Endpoint",
      "datasource": {
        "type": "loki",
