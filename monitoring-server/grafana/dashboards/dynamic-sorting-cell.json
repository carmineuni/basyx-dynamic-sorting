          },
          "refId": "eA",
          "expr": "quantile_over_time(0.5, {service=\"dynamic-sorting-application\"} |= `\"record\":\"package\"` | json value=\"notificationDelayMs\" | unwrap value | __error__=\"\" [2m]) by (service)",
